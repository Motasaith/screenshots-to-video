# ════════════════════════════════════════════════════════════════
#  AI Video Studio — Docker environment file
#  Copy this to `.env` (or use as-is with docker-compose) and fill
#  in the real values before building.
# ════════════════════════════════════════════════════════════════

# ── Backend secrets ────────────────────────────────────────────
APP_ID=
APP_SECRET=

# ── Database ──────────────────────────────────────────────────
#  Your remote/cloud MySQL connection string.
#  The app connects to this directly — no local DB container needed.
DATABASE_URL=mysql://user:password@your-remote-host:3306/aivideo

# ── Google OAuth ───────────────────────────────────────────────
#  ⚠️  In Google Cloud Console add BOTH redirect URIs:
#     http://localhost:3000/api/oauth/callback
#     http://<other-laptop-ip>:3000/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend (inlined into the Vite build via build arg) ───────
VITE_GOOGLE_CLIENT_ID=

# ── Admin role ─────────────────────────────────────────────────
OWNER_UNION_ID=

# ── Cloudflare R2 Storage ─────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aivideo
R2_PUBLIC_URL=

# ── ElevenLabs (Premium TTS voices) ────────────────────────────
ELEVENLABS_API_KEY=

# ── LLM (OpenAI-compatible API) ────────────────────────────────
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b
VISION_LLM_MODEL=gpt-oss:120b

# ── Kimi ──────────────────────────────────────────────────────
KIMI_OPEN_URL=https://api.kimi.ai

# ── Pexels (Stock Media) ──────────────────────────────────────
PEXELS_API_KEY=

# ── UploadThing (optional file uploads) ────────────────────────
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=