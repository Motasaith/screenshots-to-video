# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=mysql://root:0092068@localhost:3306/how_to             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
# Google OAuth Settings
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Backend (Auth) ─────────────────────────────────────────────

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Cloudflare R2 Storage ──────────────────────────────────────
R2_ACCOUNT_ID=            # Cloudflare account ID (found in R2 dashboard)
R2_ACCESS_KEY_ID=         # R2 API token access key ID
R2_SECRET_ACCESS_KEY=     # R2 API token secret access key
R2_BUCKET_NAME=aivideo    # R2 bucket name
R2_PUBLIC_URL=            # Optional: public URL for the bucket (e.g. https://pub-xxx.r2.dev)

# ── ElevenLabs (Premium TTS voices) ───────────────────────────
# Get a free key at https://elevenlabs.io — free tier gives 10,000 chars/month
ELEVENLABS_API_KEY=

# ── LLM (OpenAI-compatible API) ────────────────────────────────
# Recommended: Ollama Cloud (uses your ollama.com subscription)
#   LLM_BASE_URL=https://ollama.com/v1
#   LLM_API_KEY=<create one at https://ollama.com/settings/keys>
#   LLM_MODEL=gpt-oss:120b        (or qwen3:235b, deepseek-v3.1:671b)
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1 (no key needed)
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b

# ── Speech to text for the support widget (optional) ──────────────
# Browsers with the Web Speech API (Chrome, Edge, Safari) transcribe voice notes
# locally and never upload audio. These are only the fallback for browsers that
# cannot, mainly Firefox. Leave unset and those browsers get typing and image
# upload only, rather than a microphone that fails when pressed.
#
#   git clone https://github.com/ggml-org/whisper.cpp /opt/whisper.cpp
#   cd /opt/whisper.cpp && cmake -B build && cmake --build build -j --config Release
#   ./models/download-ggml-model.sh base.en
#
# WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper.cpp/models/ggml-base.en.bin

# ── Support ticket notifications (optional) ────────────────────────
# When a customer asks to talk to a person, the request lands in the admin
# dashboard under Support and the answer appears back in their chat widget. That
# path needs no configuration.
#
# These two only add email on top, for a customer who has closed the tab. They
# need a mail provider to be wired into api/lib/notify.ts first: pick one, add
# its SDK, and set SPF and DKIM on the sending domain or the mail will be
# treated as spam. Until then both are ignored and nothing is sent.
#
# SUPPORT_NOTIFY_EMAIL=you@yourdomain.com
# MAIL_FROM="AIVideo <support@yourdomain.com>"

# ── Render worker process (production) ─────────────────────────────
# The worker used to run inside the API process, where two ffmpeg processes and
# the web server competed for the same cores, so every page got slow whenever
# anybody rendered. ecosystem.config.cjs now runs it separately and sets these.
#
# WORKER_MODE=external tells the API process not to render. Leave it unset and
# the API keeps rendering, which is slower but never silently stops: a deploy
# that forgets to start the worker degrades rather than breaks.
#
# WORKER_POLL_INTERVAL_MS is how often the worker looks for queued jobs. The
# in-process worker is woken directly on enqueue and only polls as a safety net,
# so 5000 is fine there. A separate process cannot be woken that way, so it polls
# faster and the poll becomes the primary path.
#
# Render inputs are written to local disk, so workers must share this machine's
# filesystem. A worker on another box needs uploads on object storage first.
#
# WORKER_MODE=external
# WORKER_POLL_INTERVAL_MS=1500

# ── Email, through Brevo's SMTP relay ──────────────────────────────
# Free tier is 300 emails a day, which covers transactional mail long before it
# covers campaigns. Everything below is optional: with these unset, nothing is
# sent, every send is logged and skipped, and no feature breaks.
#
# Where to find these in Brevo: Settings, then SMTP & API, then the SMTP tab.
#
#   SMTP_USER is the login shown on that page, which looks like an email address.
#   SMTP_KEY  is the SMTP key from that same page. It is NOT the v3 API key, and
#             pasting the API key here gives a 535 error. Copy it with no trailing
#             space; one extra character is enough to fail.
#   MAIL_FROM must be an address on a domain you have verified in Brevo under
#             Senders, Domains & Dedicated IPs. An unverified sender is rejected.
#
# Before campaigns will land in inboxes rather than spam, add the three DNS records
# Brevo gives you on that same Domains page: a DKIM record, a Brevo code record,
# and a DMARC record. Transactional mail works without them but is more likely to
# be filtered.
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_KEY=
# MAIL_FROM="AIVideo <noreply@yourdomain.com>"
#
# Where new support tickets are announced. Optional.
# SUPPORT_NOTIFY_EMAIL=you@yourdomain.com
#
# Used for links inside emails, such as the unsubscribe link. Without it these
# fall back to https://narrashot.com.
# PUBLIC_BASE_URL=https://narrashot.com
